flowchart TD
    Start["monitor runs (interval)"] --> DeviceMode{"device-mode=advanced?"}
    DeviceMode -->|"no (home)"| Manual["state=manual-only<br/>log MONITOR_DISABLED_BY_DEVICE_MODE<br/>stop"]
    DeviceMode -->|"yes"| Clock{"clock sane?"}
    Clock -->|"no"| ClockInv["state=clock-invalid<br/>log CLOCK_INVALID<br/>stop"]
    Clock -->|"yes"| Answers["resolve 3 canaries<br/>judge CONTENT, not type"]
    Answers --> Good{"any real address?"}
    Good -->|"yes"| OnFallback{"on fallback / recovering?"}
    OnFallback -->|"yes"| Recover["recoverCount+1"]
    Recover --> RecoverThr{">= recoveryThreshold?"}
    RecoverThr -->|"no"| Recovering["state=recovering<br/>log RECOVERING (n/thr)"]
    RecoverThr -->|"yes"| Healthy["switch back to primary<br/>state=healthy<br/>log HEALTHY"]
    OnFallback -->|"no"| Healthy2["state=healthy<br/>reset counters"]
    Good -->|"no"| Stub{"answers are<br/>8.6.112.x / 8.47.69.x?"}
    Stub -->|"yes"| StubState["state=stub<br/>log STUB once<br/>second endpoint returns same pair<br/>no failover"]
    Stub -->|"no"| FailCount["failCount+1<br/>recoverCount=0"]
    FailCount --> OnFallback2{"already on fallback?"}
    OnFallback2 -->|"yes"| CheckB2["probe B"]
    CheckB2 --> B2ok{"B answers?"}
    B2ok -->|"no"| PlainDecide{"plainFallback?"}
    PlainDecide -->|"yes"| PlainState["state=plain<br/>log PRIVACY DEGRADED<br/>plain DNS"]
    PlainDecide -->|"no"| Degraded["state=degraded<br/>log DEGRADED"]
    B2ok -->|"yes"| StayB["stay on fallback"]
    OnFallback2 -->|"no"| Thr{"failCount >= failureThreshold?"}
    Thr -->|"no"| Suspect["state=suspect<br/>log SUSPECT (n/thr)"]
    Thr -->|"yes"| ProbeB["probe B first"]
    ProbeB --> Bok{"B answers?"}
    Bok -->|"no"| PlainDecide2{"plainFallback?"}
    PlainDecide2 -->|"yes"| PlainState2["state=plain<br/>log PRIVACY DEGRADED"]
    PlainDecide2 -->|"no"| Degraded2["state=degraded<br/>log DEGRADED (all down)"]
    Bok -->|"yes"| Switch["switch use-doh-server to B<br/>flush cache<br/>wait 3s"]
    Switch --> Verify{":resolve works?"}
    Verify -->|"yes"| Fallback["state=fallback<br/>log FALLBACK"]
    Verify -->|"no"| Rollback["roll back to A<br/>state=degraded"]
